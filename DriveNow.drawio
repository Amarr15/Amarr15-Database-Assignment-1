  <diagram id="4j0zymo2MkERIN-BsV2A" name="1-ERD-2-Fleet">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% ================= Entities =================\n    VC[VEHICLE_CATEGORY]\n    CPH[CATEGORY_PRICE_HISTORY]\n    CM[CAR_MODEL]\n    VH[VEHICLE]\n    GPS[GPS_DEVICE]\n    EXTRA[EXTRA_EQUIPMENT]\n    VT[VEHICLE_TRANSFER]\n\n    %% External Entities (Dashed)\n    BRANCH[/BRANCH/]\n    EMPLOYEE[/EMPLOYEE/]\n\n    %% ================= VEHICLE_CATEGORY Attributes =================\n    CATNAME([\&quot;&lt;u&gt;CategoryName (PK)&lt;/u&gt;\&quot;])\n    VC --- CATNAME\n\n    %% ================= CATEGORY_PRICE_HISTORY Attributes =================\n    CPH_START([\&quot;&lt;u&gt;StartDate (PK)&lt;/u&gt;\&quot;])\n    CPH_END([\&quot;EndDate\&quot;])\n    CPH_RATE([\&quot;DailyRate\&quot;])\n    CPH --- CPH_START\n    CPH --- CPH_END\n    CPH --- CPH_RATE\n\n    %% ================= CAR_MODEL Attributes =================\n    MID([\&quot;&lt;u&gt;ModelID (PK)&lt;/u&gt;\&quot;])\n    MANUF([\&quot;Manufacturer\&quot;])\n    MNAME([\&quot;ModelName\&quot;])\n    YEAR([\&quot;Year\&quot;])\n    SEATS([\&quot;NumSeats\&quot;])\n    TRANS([\&quot;TransmissionType\&quot;])\n    FUEL([\&quot;FuelType\&quot;])\n    CM --- MID\n    CM --- MANUF\n    CM --- MNAME\n    CM --- YEAR\n    CM --- SEATS\n    CM --- TRANS\n    CM --- FUEL\n\n    %% ================= VEHICLE Attributes =================\n    VIN([\&quot;&lt;u&gt;VIN (PK)&lt;/u&gt;\&quot;])\n    PLATE([\&quot;PlateNumber (Unique)\&quot;])\n    COLOR([\&quot;Color\&quot;])\n    ODO([\&quot;CurrentOdometer\&quot;])\n    PDATE([\&quot;PurchaseDate\&quot;])\n    PPRICE([\&quot;PurchasePrice\&quot;])\n    STATUS([\&quot;Status\&quot;])\n    CUSTOM([\&quot;CustomDailyPrice (Optional)\&quot;])\n    VH --- VIN\n    VH --- PLATE\n    VH --- COLOR\n    VH --- ODO\n    VH --- PDATE\n    VH --- PPRICE\n    VH --- STATUS\n    VH --- CUSTOM\n\n    %% ================= GPS_DEVICE Attributes =================\n    SERIAL([\&quot;&lt;u&gt;SerialNumber (PK)&lt;/u&gt;\&quot;])\n    GMANUF([\&quot;Manufacturer\&quot;])\n    SIM([\&quot;SIMCardNumber\&quot;])\n    GPS --- SERIAL\n    GPS --- GMANUF\n    GPS --- SIM\n\n    %% ================= EXTRA_EQUIPMENT Attributes =================\n    ECODE([\&quot;&lt;u&gt;ExtraCode (PK)&lt;/u&gt;\&quot;])\n    ENAME([\&quot;ExtraName\&quot;])\n    ECHARGE([\&quot;CurrentDailyCharge\&quot;])\n    EXTRA --- ECODE\n    EXTRA --- ENAME\n    EXTRA --- ECHARGE\n\n    %% ================= VEHICLE_TRANSFER Attributes =================\n    TID([\&quot;&lt;u&gt;TransferID (PK)&lt;/u&gt;\&quot;])\n    TDATE([\&quot;TransferDate\&quot;])\n    TODO([\&quot;OdometerAtTransfer\&quot;])\n    VT --- TID\n    VT --- TDATE\n    VT --- TODO\n\n    %% ================= Relationships =================\n    OF_MODEL{\&quot;OF_MODEL\&quot;}\n    BELONGS{\&quot;BELONGS_TO_CATEGORY\&quot;}\n    HAS_PRICING{\&quot;HAS_PRICING\&quot;}\n    HOME{\&quot;HOME_BRANCH\&quot;}\n    CURLOC{\&quot;CURRENT_LOCATION\&quot;}\n    HAS_TRACKER{\&quot;HAS_TRACKER\&quot;}\n    TRANSFERRED_IN{\&quot;TRANSFERRED_IN\&quot;}\n\n    %% OF_MODEL (N:1)\n    VH ---|\&quot;N\&quot;| OF_MODEL\n    OF_MODEL ---|\&quot;1\&quot;| CM\n\n    %% BELONGS_TO_CATEGORY (N:1)\n    CM ---|\&quot;N\&quot;| BELONGS\n    BELONGS ---|\&quot;1\&quot;| VC\n\n    %% HAS_PRICING (1:N)\n    VC ---|\&quot;1\&quot;| HAS_PRICING\n    HAS_PRICING ---|\&quot;N\&quot;| CPH\n\n    %% HOME_BRANCH (N:1) - Total from Vehicle side\n    VH ===|\&quot;N\&quot;| HOME\n    HOME ---|\&quot;1\&quot;| BRANCH\n\n    %% CURRENT_LOCATION (N:1)\n    VH ---|\&quot;N\&quot;| CURLOC\n    CURLOC ---|\&quot;1\&quot;| BRANCH\n\n    %% HAS_TRACKER (1:1) - Partial both sides\n    VH ---|\&quot;1\&quot;| HAS_TRACKER\n    HAS_TRACKER ---|\&quot;1\&quot;| GPS\n    HAS_TRACKER --- INST_DATE([\&quot;InstallationDate\&quot;])\n\n    %% TRANSFERRED_IN relations\n    VT ---|\&quot;N\&quot;| TRANSFERRED_IN\n    TRANSFERRED_IN ---|\&quot;1\&quot;| VH\n    TRANSFERRED_IN ---|\&quot;1 (FromBranch)\&quot;| BRANCH\n    TRANSFERRED_IN ---|\&quot;1 (ToBranch)\&quot;| BRANCH\n    TRANSFERRED_IN ---|\&quot;1 (DrivenBy)\&quot;| EMPLOYEE\n\n    %% ================= Styles =================\n    classDef entity fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px\n    classDef attribute fill:#ffffff,stroke:#64748b,color:#111827\n    classDef relationship fill:#fef3c7,stroke:#b45309,color:#111827\n    classDef external fill:#f3f4f6,stroke:#6b7280,color:#111827,stroke-width:2px,stroke-dasharray: 5 5\n\n    class VC,CPH,CM,VH,GPS,EXTRA,VT entity\n    class CATNAME,CPH_START,CPH_END,CPH_RATE,MID,MANUF,MNAME,YEAR,SEATS,TRANS,FUEL,VIN,PLATE,COLOR,ODO,PDATE,PPRICE,STATUS,CUSTOM,SERIAL,GMANUF,SIM,ECODE,ENAME,ECHARGE,TID,TDATE,TODO,INST_DATE attribute\n    class OF_MODEL,BELONGS,HAS_PRICING,HOME,CURLOC,HAS_TRACKER,TRANSFERRED_IN relationship\n    class BRANCH,EMPLOYEE external&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="0L6H3PZ7-a1BsrP3xdJm-109">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
