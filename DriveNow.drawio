  </diagram>
  <diagram id="I8TkNktyuLTNSPGPSH-d" name="4-Business-Rules">
    <mxGraphModel dx="3183" dy="2443" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% ================= Title =================\n    Title[\&quot;&lt;b&gt;Part D — Business Rules Beyond Constraints&lt;/b&gt;&lt;br&gt;Name: [Your Name] | ID: [Your ID] | Group: [Your Group]\&quot;]\n    style Title fill:#1e293b,stroke:#0f172a,color:#ffffff,stroke-width:3px,font-size:18px\n\n    %% ================= Rule 1 =================\n    subgraph R1 [Rule 1]\n        direction TB\n        R1_SRS[\&quot;&lt;b&gt;SRS Section:&lt;/b&gt; 7.6 &amp; 8 (Fleet Manager)\&quot;]\n        R1_RULE[\&quot;&lt;b&gt;Business Rule:&lt;/b&gt;&lt;br&gt;No vehicle can be transferred to the same branch it is currently located at, and the origin branch must match the vehicle&#39;s current actual branch.\&quot;]\n        R1_WHY[\&quot;&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&lt;br&gt;Standard CHECK constraints can only compare columns within the same row (FromBranch != ToBranch). They cannot query the VEHICLE table to verify whether FromBranch matches the vehicle&#39;s real-time current branch location (VEHICLE.CurrentBranchCode).\&quot;]\n        R1_HOW[\&quot;&lt;b&gt;How to enforce it:&lt;/b&gt;&lt;br&gt;Enforced via a BEFORE INSERT Trigger on the VEHICLE_TRANSFER table (or a stored procedure) that validates FromBranchCode == VEHICLE.CurrentBranchCode, rejects the transfer if invalid, and upon approval updates VEHICLE.CurrentBranchCode = ToBranchCode.\&quot;]\n        \n        R1_SRS --- R1_RULE --- R1_WHY --- R1_HOW\n    end\n\n    %% ================= Rule 2 =================\n    subgraph R2 [Rule 2]\n        direction TB\n        R2_SRS[\&quot;&lt;b&gt;SRS Section:&lt;/b&gt; 7.7 &amp; 7.11\&quot;]\n        R2_RULE[\&quot;&lt;b&gt;Business Rule:&lt;/b&gt;&lt;br&gt;A blacklisted customer cannot make any new reservations or enter into rental agreements.\&quot;]\n        R2_WHY[\&quot;&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&lt;br&gt;Foreign keys only ensure referential existence, and CHECK constraints cannot run subqueries on the BLACKLIST_RECORD table to inspect whether the CustomerID has an active blacklist record.\&quot;]\n        R2_HOW[\&quot;&lt;b&gt;How to enforce it:&lt;/b&gt;&lt;br&gt;Enforced via a BEFORE INSERT Trigger on both RESERVATION and RENTAL tables (or within the CreateReservation / CreateRental Stored Procedure) that queries BLACKLIST_RECORD and raises an exception if the customer exists in the blacklist.\&quot;]\n        \n        R2_SRS --- R2_RULE --- R2_WHY --- R2_HOW\n    end\n\n    %% ================= Rule 3 =================\n    subgraph R3 [Rule 3]\n        direction TB\n        R3_SRS[\&quot;&lt;b&gt;SRS Section:&lt;/b&gt; 7.9 (Promotions)\&quot;]\n        R3_RULE[\&quot;&lt;b&gt;Business Rule:&lt;/b&gt;&lt;br&gt;A promo code cannot exceed its maximum number of uses (MaxUses).\&quot;]\n        R3_WHY[\&quot;&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&lt;br&gt;Standard constraints cannot calculate aggregate functions (such as COUNT(*)) across multiple reservation rows to determine whether total redemptions have reached MaxUses.\&quot;]\n        R3_HOW[\&quot;&lt;b&gt;How to enforce it:&lt;/b&gt;&lt;br&gt;Enforced via a Stored Procedure or BEFORE INSERT Trigger on RESERVATION that counts previous usages of the promo code and aborts the insert if COUNT(*) &gt;= MaxUses, then increments TimesUsed.\&quot;]\n        \n        R3_SRS --- R3_RULE --- R3_WHY --- R3_HOW\n    end\n\n    %% ================= Rule 4 =================\n    subgraph R4 [Rule 4]\n        direction TB\n        R4_SRS[\&quot;&lt;b&gt;SRS Section:&lt;/b&gt; 7.12 (Rentals - Extension Chain)\&quot;]\n        R4_RULE[\&quot;&lt;b&gt;Business Rule:&lt;/b&gt;&lt;br&gt;A rental agreement can only be extended once directly (creating a sequential 1:1 extension chain).\&quot;]\n        R4_WHY[\&quot;&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&lt;br&gt;While a unique constraint UNIQUE(ParentRentalNo) prevents two rentals from extending the same parent, constraints cannot prevent circular reference chains (e.g. A extends B extends A) or verify that the extension dates strictly follow the parent rental&#39;s return date.\&quot;]\n        R4_HOW[\&quot;&lt;b&gt;How to enforce it:&lt;/b&gt;&lt;br&gt;Enforced via a Stored Procedure or BEFORE INSERT Trigger on RENTAL that verifies the parent rental has not been previously extended, is currently in an active/valid state, and sets up the next link in the extension chain.\&quot;]\n        \n        R4_SRS --- R4_RULE --- R4_WHY --- R4_HOW\n    end\n\n    %% ================= Styles =================\n    classDef titleBox fill:#1e293b,stroke:#0f172a,color:#ffffff,stroke-width:3px,font-size:18px\n    classDef headerBox fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px,font-weight:bold,text-align:left\n    classDef contentBox fill:#ffffff,stroke:#64748b,color:#111827,stroke-width:1px,text-align:left\n    classDef subgraphStyle fill:#f8fafc,stroke:#cbd5e1,stroke-width:2px\n\n    class Title titleBox\n    class R1_SRS,R2_SRS,R3_SRS,R4_SRS headerBox\n    class R1_RULE,R2_RULE,R3_RULE,R4_RULE,R1_WHY,R2_WHY,R3_WHY,R4_WHY,R1_HOW,R2_HOW,R3_HOW,R4_HOW contentBox\n    style R1 fill:#f8fafc,stroke:#cbd5e1,stroke-width:2px\n    style R2 fill:#f8fafc,stroke:#cbd5e1,stroke-width:2px\n    style R3 fill:#f8fafc,stroke:#cbd5e1,stroke-width:2px\n    style R4 fill:#f8fafc,stroke:#cbd5e1,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="FflQV6nAqRwETxv3Kj53-9">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Rule 4" mermaidId="n:R4" mermaidBaseStyle="html=1;whiteSpace=nowrap;strokeWidth=2;verticalAlign=top;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#000000;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Rule 4" id="FflQV6nAqRwETxv3Kj53-10">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-9" style="html=1;whiteSpace=nowrap;strokeWidth=2;verticalAlign=top;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#000000;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="1416" width="200" x="30" y="220" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;SRS Section:&lt;/b&gt; 7.12 (Rentals - Extension Chain)" mermaidId="n:R4_SRS" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontStyle=1;" mermaidBaseValue="&lt;b&gt;SRS Section:&lt;/b&gt; 7.12 (Rentals - Extension Chain)" id="FflQV6nAqRwETxv3Kj53-11">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-10" style="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontStyle=1;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="108" width="152" x="24" y="48" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Business Rule:&lt;/b&gt;&#xa;A rental agreement can only be extended once directly (creating a sequential 1:1 extension chain)." mermaidId="n:R4_RULE" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;Business Rule:&lt;/b&gt;&#xa;A rental agreement can only be extended once directly (creating a sequential 1:1 extension chain)." id="FflQV6nAqRwETxv3Kj53-12">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-10" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="255" width="152" x="24" y="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&#xa;While a unique constraint UNIQUE(ParentRentalNo) prevents two rentals from extending the same parent, constraints cannot prevent circular reference chains (e.g. A extends B extends A) or verify that the extension dates strictly follow the parent rental&#39;s return date." mermaidId="n:R4_WHY" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&#xa;While a unique constraint UNIQUE(ParentRentalNo) prevents two rentals from extending the same parent, constraints cannot prevent circular reference chains (e.g. A extends B extends A) or verify that the extension dates strictly follow the parent rental&#39;s return date." id="FflQV6nAqRwETxv3Kj53-13">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-10" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="487" width="152" x="24" y="459" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;How to enforce it:&lt;/b&gt;&#xa;Enforced via a Stored Procedure or BEFORE INSERT Trigger on RENTAL that verifies the parent rental has not been previously extended, is currently in an active/valid state, and sets up the next link in the extension chain." mermaidId="n:R4_HOW" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;How to enforce it:&lt;/b&gt;&#xa;Enforced via a Stored Procedure or BEFORE INSERT Trigger on RENTAL that verifies the parent rental has not been previously extended, is currently in an active/valid state, and sets up the next link in the extension chain." id="FflQV6nAqRwETxv3Kj53-14">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-10" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="423" width="152" x="24" y="970" as="geometry" />
