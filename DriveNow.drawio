  <diagram id="GWjF1PYgIv_ulbV5PP0t" name="2-Schema-2">
    <mxGraphModel dx="9150" dy="7025" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% ================= CUSTOMER =================\n    subgraph CUSTOMER_TABLE [CUSTOMER]\n        direction LR\n        C1[\&quot;&lt;u&gt;CustomerID&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        C2[\&quot;Email&lt;br&gt;NN UQ\&quot;]\n        C3[\&quot;Address&lt;br&gt;NN\&quot;]\n        C4[\&quot;RegistrationDate&lt;br&gt;NN\&quot;]\n        C5[\&quot;CustomerType&lt;br&gt;NN CK:&#39;Individual&#39;|&#39;Corporate&#39;\&quot;]\n    end\n\n    %% ================= CUSTOMER_PHONE =================\n    subgraph CUST_PHONE_TABLE [CUSTOMER_PHONE]\n        direction LR\n        CP1[\&quot;&lt;u&gt;CustomerID&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        CP2[\&quot;&lt;u&gt;PhoneNumber&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n    end\n\n    %% ================= INDIVIDUAL_CUSTOMER =================\n    subgraph IND_TABLE [INDIVIDUAL_CUSTOMER]\n        direction LR\n        I1[\&quot;&lt;u&gt;CustomerID&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        I2[\&quot;FirstName&lt;br&gt;NN\&quot;]\n        I3[\&quot;LastName&lt;br&gt;NN\&quot;]\n        I4[\&quot;DateOfBirth&lt;br&gt;NN\&quot;]\n        I5[\&quot;IDType&lt;br&gt;NN CK:&#39;NationalID&#39;|&#39;Passport&#39;\&quot;]\n        I6[\&quot;IDNumber&lt;br&gt;NN UQ\&quot;]\n        I7[\&quot;LicenseNumber&lt;br&gt;NN UQ\&quot;]\n        I8[\&quot;LicenseCountry&lt;br&gt;NN\&quot;]\n        I9[\&quot;LicenseExpiryDate&lt;br&gt;NN\&quot;]\n        I10[\&quot;LoyaltyPoints&lt;br&gt;NN DF:0 CK:&gt;=0\&quot;]\n        I11[\&quot;LoyaltyTier&lt;br&gt;NN DF:&#39;Silver&#39; CK:&#39;Silver&#39;|&#39;Gold&#39;|&#39;Platinum&#39;\&quot;]\n    end\n\n    %% ================= CORPORATE_CUSTOMER =================\n    subgraph CORP_TABLE [CORPORATE_CUSTOMER]\n        direction LR\n        CO1[\&quot;&lt;u&gt;CustomerID&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        CO2[\&quot;CompanyName&lt;br&gt;NN UQ\&quot;]\n        CO3[\&quot;TaxRegistrationNumber&lt;br&gt;NN UQ\&quot;]\n        CO4[\&quot;ContactPersonName&lt;br&gt;NN\&quot;]\n        CO5[\&quot;CreditLimit&lt;br&gt;NN CK:&gt;0\&quot;]\n    end\n\n    %% ================= AUTHORIZED_DRIVER =================\n    subgraph AUTH_DRIVER_TABLE [AUTHORIZED_DRIVER]\n        direction LR\n        AD1[\&quot;&lt;u&gt;CorporateCustID&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        AD2[\&quot;&lt;u&gt;CompanyDriverNo&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        AD3[\&quot;FullName&lt;br&gt;NN\&quot;]\n        AD4[\&quot;LicenseNumber&lt;br&gt;NN\&quot;]\n        AD5[\&quot;LicenseExpiryDate&lt;br&gt;NN\&quot;]\n        AD6[\&quot;Phone&lt;br&gt;NN\&quot;]\n    end\n\n    %% ================= BLACKLIST_RECORD =================\n    subgraph BLACK_TABLE [BLACKLIST_RECORD]\n        direction LR\n        BL1[\&quot;&lt;u&gt;BlacklistID&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        BL2[\&quot;CustomerID&lt;br&gt;NN UQ (FK)\&quot;]\n        BL3[\&quot;ManagerID&lt;br&gt;NN (FK)\&quot;]\n        BL4[\&quot;BlacklistDate&lt;br&gt;NN\&quot;]\n        BL5[\&quot;Reason&lt;br&gt;NN\&quot;]\n    end\n\n    %% ================= CORPORATE_DISCOUNT =================\n    subgraph CORP_DISC_TABLE [CORPORATE_DISCOUNT]\n        direction LR\n        CD1[\&quot;&lt;u&gt;CorporateCustID&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        CD2[\&quot;&lt;u&gt;CategoryName&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        CD3[\&quot;DiscountPercentage&lt;br&gt;NN CK:&gt;0 AND &lt;=0.50\&quot;]\n        CD4[\&quot;&lt;u&gt;StartDate&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        CD5[\&quot;EndDate&lt;br&gt;NN\&quot;]\n    end\n\n    %% ================= PROMO_CODE =================\n    subgraph PROMO_TABLE [PROMO_CODE]\n        direction LR\n        PR1[\&quot;&lt;u&gt;PromoCode&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        PR2[\&quot;DiscountPercentage&lt;br&gt;NN CK:&gt;0 AND &lt;=1.0\&quot;]\n        PR3[\&quot;StartDate&lt;br&gt;NN\&quot;]\n        PR4[\&quot;EndDate&lt;br&gt;NN\&quot;]\n        PR5[\&quot;MaxUses&lt;br&gt;NN CK:&gt;0\&quot;]\n        PR6[\&quot;TimesUsed&lt;br&gt;NN DF:0 CK:&gt;=0\&quot;]\n    end\n\n    %% ================= RESERVATION =================\n    subgraph RES_TABLE [RESERVATION]\n        direction LR\n        R1[\&quot;&lt;u&gt;ReservationNo&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        R2[\&quot;BookingDateTime&lt;br&gt;NN\&quot;]\n        R3[\&quot;PickupDateTime&lt;br&gt;NN\&quot;]\n        R4[\&quot;ExpectedReturnDateTime&lt;br&gt;NN\&quot;]\n        R5[\&quot;Status&lt;br&gt;NN DF:&#39;Pending&#39; CK:&#39;Pending&#39;|&#39;Confirmed&#39;|&#39;Cancelled&#39;|&#39;Completed&#39;|&#39;No-Show&#39;\&quot;]\n        R6[\&quot;CustomerID&lt;br&gt;NN (FK)\&quot;]\n        R7[\&quot;CategoryName&lt;br&gt;NN (FK)\&quot;]\n        R8[\&quot;PickupBranchCode&lt;br&gt;NN (FK)\&quot;]\n        R9[\&quot;ReturnBranchCode&lt;br&gt;NN (FK)\&quot;]\n        R10[\&quot;PromoCode&lt;br&gt;NULL (FK)\&quot;]\n    end\n\n    %% ================= INSURANCE_PACKAGE =================\n    subgraph INS_TABLE [INSURANCE_PACKAGE]\n        direction LR\n        IN1[\&quot;&lt;u&gt;PackageCode&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        IN2[\&quot;PackageName&lt;br&gt;NN\&quot;]\n        IN3[\&quot;DailyPrice&lt;br&gt;NN CK:&gt;=0\&quot;]\n        IN4[\&quot;MaxCoverage&lt;br&gt;NN CK:&gt;0\&quot;]\n        IN5[\&quot;Deductible&lt;br&gt;NN CK:&gt;=0\&quot;]\n    end\n\n    %% ================= RENTAL =================\n    subgraph RENTAL_TABLE [RENTAL]\n        direction LR\n        RT1[\&quot;&lt;u&gt;RentalNo&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        RT2[\&quot;ReservationNo&lt;br&gt;NULL UQ (FK)\&quot;]\n        RT3[\&quot;ParentRentalNo&lt;br&gt;NULL UQ (FK)\&quot;]\n        RT4[\&quot;VIN&lt;br&gt;NN (FK)\&quot;]\n        RT5[\&quot;CustomerID&lt;br&gt;NN (FK)\&quot;]\n        RT6[\&quot;PickupBranchCode&lt;br&gt;NN (FK)\&quot;]\n        RT7[\&quot;ReturnBranchCode&lt;br&gt;NN (FK)\&quot;]\n        RT8[\&quot;HandoverAgentID&lt;br&gt;NN (FK)\&quot;]\n        RT9[\&quot;ReceivingAgentID&lt;br&gt;NULL (FK)\&quot;]\n        RT10[\&quot;CorporateDriverNo&lt;br&gt;NULL (FK)\&quot;]\n        RT11[\&quot;PickupDateTime&lt;br&gt;NN\&quot;]\n        RT12[\&quot;ExpectedReturnDateTime&lt;br&gt;NN\&quot;]\n        RT13[\&quot;ActualReturnDateTime&lt;br&gt;NULL\&quot;]\n        RT14[\&quot;PickupOdometer&lt;br&gt;NN CK:&gt;=0\&quot;]\n        RT15[\&quot;ReturnOdometer&lt;br&gt;NULL\&quot;]\n        RT16[\&quot;PickupFuelPercentage&lt;br&gt;NN CK:0-100\&quot;]\n        RT17[\&quot;ReturnFuelPercentage&lt;br&gt;NULL CK:0-100\&quot;]\n        RT18[\&quot;LateFeeCharged&lt;br&gt;NULL CK:&gt;=0\&quot;]\n    end\n\n    %% ================= RENTAL_ADDITIONAL_DRIVER =================\n    subgraph RENT_ADD_DRV_TABLE [RENTAL_ADDITIONAL_DRIVER]\n        direction LR\n        RAD1[\&quot;&lt;u&gt;RentalNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        RAD2[\&quot;&lt;u&gt;DriverName&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        RAD3[\&quot;LicenseNumber&lt;br&gt;NN\&quot;]\n        RAD4[\&quot;DailyFee&lt;br&gt;NN CK:&gt;=0\&quot;]\n    end\n\n    %% ================= RENTAL_EXTRA =================\n    subgraph RENT_EXTRA_TABLE [RENTAL_EXTRA]\n        direction LR\n        RE1[\&quot;&lt;u&gt;RentalNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        RE2[\&quot;&lt;u&gt;ExtraCode&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        RE3[\&quot;Quantity&lt;br&gt;NN CK:&gt;0\&quot;]\n        RE4[\&quot;DailyChargeAtRental&lt;br&gt;NN CK:&gt;=0\&quot;]\n    end\n\n    %% ================= RENTAL_INSURANCE =================\n    subgraph RENT_INS_TABLE [RENTAL_INSURANCE]\n        direction LR\n        RI1[\&quot;&lt;u&gt;RentalNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        RI2[\&quot;&lt;u&gt;PackageCode&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        RI3[\&quot;DailyPriceAtRental&lt;br&gt;NN CK:&gt;=0\&quot;]\n    end\n\n    %% ================= PAYMENT =================\n    subgraph PAY_TABLE [PAYMENT]\n        direction LR\n        P1[\&quot;&lt;u&gt;PaymentID&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        P2[\&quot;RentalNo&lt;br&gt;NN (FK)\&quot;]\n        P3[\&quot;Amount&lt;br&gt;NN CK:&gt;0\&quot;]\n        P4[\&quot;PaymentDateTime&lt;br&gt;NN\&quot;]\n        P5[\&quot;PaymentType&lt;br&gt;NN CK:&#39;Deposit&#39;|&#39;Final&#39;|&#39;Damage&#39;|&#39;LateFee&#39;|&#39;TrafficFine&#39;\&quot;]\n        P6[\&quot;Method&lt;br&gt;NN CK:&#39;Cash&#39;|&#39;Card&#39;|&#39;BankTransfer&#39;\&quot;]\n        P7[\&quot;BankTransactionRef&lt;br&gt;NULL UQ\&quot;]\n    end\n\n    %% ================= LOYALTY_TRANSACTION =================\n    subgraph LOY_TABLE [LOYALTY_TRANSACTION]\n        direction LR\n        L1[\&quot;&lt;u&gt;TransactionID&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        L2[\&quot;CustomerID&lt;br&gt;NN (FK)\&quot;]\n        L3[\&quot;RentalNo&lt;br&gt;NULL (FK)\&quot;]\n        L4[\&quot;TransactionDate&lt;br&gt;NN\&quot;]\n        L5[\&quot;Points&lt;br&gt;NN\&quot;]\n        L6[\&quot;TransactionType&lt;br&gt;NN CK:&#39;Earned&#39;|&#39;Redeemed&#39;\&quot;]\n    end\n\n    %% ================= DAMAGE_REPORT =================\n    subgraph DMG_TABLE [DAMAGE_REPORT]\n        direction LR\n        D1[\&quot;&lt;u&gt;RentalNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        D2[\&quot;&lt;u&gt;ReportNo&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        D3[\&quot;Description&lt;br&gt;NN\&quot;]\n        D4[\&quot;Severity&lt;br&gt;NN CK:&#39;Minor&#39;|&#39;Moderate&#39;|&#39;Severe&#39;\&quot;]\n        D5[\&quot;EstimatedCost&lt;br&gt;NN CK:&gt;=0\&quot;]\n        D6[\&quot;ReportedByAgentID&lt;br&gt;NN (FK)\&quot;]\n    end\n\n    %% ================= DAMAGE_PHOTO =================\n    subgraph DMG_PHOTO_TABLE [DAMAGE_PHOTO]\n        direction LR\n        DP1[\&quot;&lt;u&gt;RentalNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        DP2[\&quot;&lt;u&gt;ReportNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        DP3[\&quot;&lt;u&gt;PhotoURL&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n    end\n\n    %% ================= TRAFFIC_VIOLATION =================\n    subgraph VIOL_TABLE [TRAFFIC_VIOLATION]\n        direction LR\n        V1[\&quot;&lt;u&gt;ViolationNo&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        V2[\&quot;RentalNo&lt;br&gt;NN (FK)\&quot;]\n        V3[\&quot;ViolationDateTime&lt;br&gt;NN\&quot;]\n        V4[\&quot;Location&lt;br&gt;NN\&quot;]\n        V5[\&quot;ViolationType&lt;br&gt;NN\&quot;]\n        V6[\&quot;FineAmount&lt;br&gt;NN CK:&gt;0\&quot;]\n    end\n\n    %% ================= FEEDBACK =================\n    subgraph FB_TABLE [FEEDBACK]\n        direction LR\n        F1[\&quot;&lt;u&gt;FeedbackID&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        F2[\&quot;RentalNo&lt;br&gt;NN UQ (FK)\&quot;]\n        F3[\&quot;Rating&lt;br&gt;NN CK:1-5\&quot;]\n        F4[\&quot;Comment&lt;br&gt;NULL\&quot;]\n        F5[\&quot;SubmissionDate&lt;br&gt;NN\&quot;]\n    end\n\n    %% ================= JOB_CARD =================\n    subgraph JOB_TABLE [JOB_CARD]\n        direction LR\n        J1[\&quot;&lt;u&gt;JobNo&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        J2[\&quot;VIN&lt;br&gt;NN (FK)\&quot;]\n        J3[\&quot;DamageRentalNo&lt;br&gt;NULL (FK)\&quot;]\n        J4[\&quot;DamageReportNo&lt;br&gt;NULL (FK)\&quot;]\n        J5[\&quot;DateIn&lt;br&gt;NN\&quot;]\n        J6[\&quot;DateOut&lt;br&gt;NULL\&quot;]\n        J7[\&quot;WorkType&lt;br&gt;NN CK:&#39;Routine&#39;|&#39;Repair&#39;|&#39;Inspection&#39;\&quot;]\n        J8[\&quot;TotalCost&lt;br&gt;NN DF:0 CK:&gt;=0\&quot;]\n    end\n\n    %% ================= JOB_MECHANIC =================\n    subgraph JOB_MECH_TABLE [JOB_MECHANIC]\n        direction LR\n        JM1[\&quot;&lt;u&gt;JobNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        JM2[\&quot;&lt;u&gt;MechanicID&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        JM3[\&quot;HoursSpent&lt;br&gt;NN CK:&gt;0\&quot;]\n    end\n\n    %% ================= PART =================\n    subgraph PART_TABLE [PART]\n        direction LR\n        PT1[\&quot;&lt;u&gt;PartNo&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        PT2[\&quot;PartName&lt;br&gt;NN\&quot;]\n        PT3[\&quot;CurrentUnitCost&lt;br&gt;NN CK:&gt;0\&quot;]\n        PT4[\&quot;QuantityInStock&lt;br&gt;NN DF:0 CK:&gt;=0\&quot;]\n    end\n\n    %% ================= SUPPLIER =================\n    subgraph SUP_TABLE [SUPPLIER]\n        direction LR\n        SU1[\&quot;&lt;u&gt;SupplierID&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        SU2[\&quot;SupplierName&lt;br&gt;NN\&quot;]\n        SU3[\&quot;Phone&lt;br&gt;NN\&quot;]\n        SU4[\&quot;Email&lt;br&gt;NN UQ\&quot;]\n    end\n\n    %% ================= PART_SUPPLIER =================\n    subgraph PART_SUP_TABLE [PART_SUPPLIER]\n        direction LR\n        PS1[\&quot;&lt;u&gt;PartNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        PS2[\&quot;&lt;u&gt;SupplierID&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        PS3[\&quot;SupplierPrice&lt;br&gt;NN CK:&gt;0\&quot;]\n        PS4[\&quot;LeadTimeDays&lt;br&gt;NN CK:&gt;=0\&quot;]\n    end\n\n    %% ================= JOB_PART =================\n    subgraph JOB_PART_TABLE [JOB_PART]\n        direction LR\n        JP1[\&quot;&lt;u&gt;JobNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        JP2[\&quot;&lt;u&gt;PartNo&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        JP3[\&quot;QuantityUsed&lt;br&gt;NN CK:&gt;0\&quot;]\n        JP4[\&quot;UnitCostAtTime&lt;br&gt;NN CK:&gt;0\&quot;]\n    end\n\n    %% ================= External Reference Boxes (Dashed) =================\n    EXT_EMP[\&quot;EMPLOYEE.EmployeeID\&quot;]\n    EXT_VCAT[\&quot;VEHICLE_CATEGORY.CategoryName\&quot;]\n    EXT_BRANCH[\&quot;BRANCH.BranchCode\&quot;]\n    EXT_VEH[\&quot;VEHICLE.VIN\&quot;]\n    EXT_EXTRA[\&quot;EXTRA_EQUIPMENT.ExtraCode\&quot;]\n\n    %% ================= Relationships (FK Arrows) =================\n    %% Customer hierarchy\n    CP1 --&gt;|FK| C1\n    I1 --&gt;|FK| C1\n    CO1 --&gt;|FK| C1\n    AD1 --&gt;|FK| CO1\n    BL2 --&gt;|FK| C1\n    BL3 --&gt;|FK| EXT_EMP\n    CD1 --&gt;|FK| CO1\n    CD2 --&gt;|FK| EXT_VCAT\n\n    %% Reservation\n    R6 --&gt;|FK| C1\n    R7 --&gt;|FK| EXT_VCAT\n    R8 --&gt;|FK| EXT_BRANCH\n    R9 --&gt;|FK| EXT_BRANCH\n    R10 --&gt;|FK| PR1\n\n    %% Rental\n    RT2 --&gt;|FK| R1\n    RT3 --&gt;|FK| RT1\n    RT4 --&gt;|FK| EXT_VEH\n    RT5 --&gt;|FK| C1\n    RT6 --&gt;|FK| EXT_BRANCH\n    RT7 --&gt;|FK| EXT_BRANCH\n    RT8 --&gt;|FK| EXT_EMP\n    RT9 --&gt;|FK| EXT_EMP\n    RT10 --&gt;|FK| AD2\n\n    %% Rental details\n    RAD1 --&gt;|FK| RT1\n    RE1 --&gt;|FK| RT1\n    RE2 --&gt;|FK| EXT_EXTRA\n    RI1 --&gt;|FK| RT1\n    RI2 --&gt;|FK| IN1\n    P2 --&gt;|FK| RT1\n    L2 --&gt;|FK| I1\n    L3 --&gt;|FK| RT1\n    D1 --&gt;|FK| RT1\n    D6 --&gt;|FK| EXT_EMP\n    DP1 --&gt;|FK| D1\n    DP2 --&gt;|FK| D2\n    V2 --&gt;|FK| RT1\n    F2 --&gt;|FK| RT1\n    J2 --&gt;|FK| EXT_VEH\n    J3 --&gt;|FK| D1\n    J4 --&gt;|FK| D2\n    JM1 --&gt;|FK| J1\n    JM2 --&gt;|FK| EXT_EMP\n    PS1 --&gt;|FK| PT1\n    PS2 --&gt;|FK| SU1\n    JP1 --&gt;|FK| J1\n    JP2 --&gt;|FK| PT1\n\n    %% ================= Table Constraints (Notes) =================\n    CORP_DISC_NOTE[\&quot;CK: EndDate &gt;= StartDate\&quot;]\n    CORP_DISC_TABLE --- CORP_DISC_NOTE\n\n    PROMO_NOTE[\&quot;CK: EndDate &gt;= StartDate\&quot;]\n    PROMO_TABLE --- PROMO_NOTE\n\n    RES_NOTE[\&quot;CK: ExpectedReturnDateTime &gt; PickupDateTime\&quot;]\n    RES_TABLE --- RES_NOTE\n\n    RENTAL_NOTE[\&quot;CK: ReturnOdometer &gt;= PickupOdometer&lt;br&gt;CK: ActualReturnDateTime &gt;= PickupDateTime\&quot;]\n    RENTAL_TABLE --- RENTAL_NOTE\n\n    JOB_NOTE[\&quot;CK: DateOut &gt;= DateIn\&quot;]\n    JOB_TABLE --- JOB_NOTE\n\n    %% ================= Styles =================\n    classDef colBox fill:#ffffff,stroke:#64748b,color:#111827,stroke-width:1.5px\n    classDef noteBox fill:#fef3c7,stroke:#b45309,color:#111827,stroke-width:1.5px,stroke-dasharray: 3 3\n    classDef extBox fill:#f3f4f6,stroke:#6b7280,color:#111827,stroke-width:2px,stroke-dasharray: 5 5\n\n    class C1,C2,C3,C4,C5,CP1,CP2,I1,I2,I3,I4,I5,I6,I7,I8,I9,I10,I11,CO1,CO2,CO3,CO4,CO5,AD1,AD2,AD3,AD4,AD5,AD6,BL1,BL2,BL3,BL4,BL5,CD1,CD2,CD3,CD4,CD5,PR1,PR2,PR3,PR4,PR5,PR6,R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,IN1,IN2,IN3,IN4,IN5,RT1,RT2,RT3,RT4,RT5,RT6,RT7,RT8,RT9,RT10,RT11,RT12,RT13,RT14,RT15,RT16,RT17,RT18,RAD1,RAD2,RAD3,RAD4,RE1,RE2,RE3,RE4,RI1,RI2,RI3,P1,P2,P3,P4,P5,P6,P7,L1,L2,L3,L4,L5,L6,D1,D2,D3,D4,D5,D6,DP1,DP2,DP3,V1,V2,V3,V4,V5,V6,F1,F2,F3,F4,F5,J1,J2,J3,J4,J5,J6,J7,J8,JM1,JM2,JM3,PT1,PT2,PT3,PT4,SU1,SU2,SU3,SU4,PS1,PS2,PS3,PS4,JP1,JP2,JP3,JP4 colBox\n    class CORP_DISC_NOTE,PROMO_NOTE,RES_NOTE,RENTAL_NOTE,JOB_NOTE noteBox\n    class EXT_EMP,EXT_VCAT,EXT_BRANCH,EXT_VEH,EXT_EXTRA extBox&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="cdvPHzpmsmWbvyyc1B1x-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="JOB_PART" mermaidId="n:JOB_PART_TABLE" mermaidBaseStyle="html=1;whiteSpace=nowrap;strokeWidth=1;verticalAlign=top;fillColor=#F0FDFA;strokeColor=#2DD4BF;fontColor=#000000;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="JOB_PART" id="cdvPHzpmsmWbvyyc1B1x-2">
          <mxCell parent="cdvPHzpmsmWbvyyc1B1x-1" style="html=1;whiteSpace=nowrap;strokeWidth=1;verticalAlign=top;fillColor=#F0FDFA;strokeColor=#2DD4BF;fontColor=#000000;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="139" width="806" x="9916" y="30" as="geometry" />
          </mxCell>
