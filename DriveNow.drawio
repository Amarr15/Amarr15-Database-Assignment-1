        <UserObject label="&lt;b&gt;How to enforce it:&lt;/b&gt;&#xa;Enforced via a Stored Procedure or BEFORE INSERT Trigger on RESERVATION that counts previous usages of the promo code and aborts the insert if COUNT(*) &gt;= MaxUses, then increments TimesUsed." mermaidId="n:R3_HOW" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;How to enforce it:&lt;/b&gt;&#xa;Enforced via a Stored Procedure or BEFORE INSERT Trigger on RESERVATION that counts previous usages of the promo code and aborts the insert if COUNT(*) &gt;= MaxUses, then increments TimesUsed." id="FflQV6nAqRwETxv3Kj53-22">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-18" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
