        <UserObject label="&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&#xa;Standard constraints cannot calculate aggregate functions (such as COUNT(*)) across multiple reservation rows to determine whether total redemptions have reached MaxUses." mermaidId="n:R3_WHY" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&#xa;Standard constraints cannot calculate aggregate functions (such as COUNT(*)) across multiple reservation rows to determine whether total redemptions have reached MaxUses." id="FflQV6nAqRwETxv3Kj53-21">
