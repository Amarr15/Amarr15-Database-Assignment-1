        </UserObject>
        <UserObject label="&lt;b&gt;Business Rule:&lt;/b&gt;&#xa;A blacklisted customer cannot make any new reservations or enter into rental agreements." mermaidId="n:R2_RULE" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;Business Rule:&lt;/b&gt;&#xa;A blacklisted customer cannot make any new reservations or enter into rental agreements." id="FflQV6nAqRwETxv3Kj53-28">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-26" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="192" width="152" x="24" y="139" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&#xa;Foreign keys only ensure referential existence, and CHECK constraints cannot run subqueries on the BLACKLIST_RECORD table to inspect whether the CustomerID has an active blacklist record." mermaidId="n:R2_WHY" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&#xa;Foreign keys only ensure referential existence, and CHECK constraints cannot run subqueries on the BLACKLIST_RECORD table to inspect whether the CustomerID has an active blacklist record." id="FflQV6nAqRwETxv3Kj53-29">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-26" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="402" width="152" x="24" y="354" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;How to enforce it:&lt;/b&gt;&#xa;Enforced via a BEFORE INSERT Trigger on both RESERVATION and RENTAL tables (or within the CreateReservation / CreateRental Stored Procedure) that queries BLACKLIST_RECORD and raises an exception if the customer exists in the blacklist." mermaidId="n:R2_HOW" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;How to enforce it:&lt;/b&gt;&#xa;Enforced via a BEFORE INSERT Trigger on both RESERVATION and RENTAL tables (or within the CreateReservation / CreateRental Stored Procedure) that queries BLACKLIST_RECORD and raises an exception if the customer exists in the blacklist." id="FflQV6nAqRwETxv3Kj53-30">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-26" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="402" width="152" x="24" y="780" as="geometry" />
          </mxCell>
