          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;#&lt;/b&gt; | &lt;b&gt;SRS Section&lt;/b&gt; | &lt;b&gt;Question&lt;/b&gt;&#xa;&#xa;-----------------------------------------------------------------------------------------&#xa;&#xa;&lt;b&gt;Q1&lt;/b&gt; | 7.1 Branches and Staff | What is the fallback if both the branch manager resigns and the regional director is temporarily unavailable to take over? Does the system need to log acting managers?&#xa;&#xa;-----------------------------------------------------------------------------------------&#xa;&#xa;&lt;b&gt;Q2&lt;/b&gt; | 7.16 Payments | For corporate clients who receive a single monthly invoice instead of paying per rental, does the system track credit billing cycles and corporate invoice IDs, or is corporate invoicing completely handled offline in Phase 1?&#xa;&#xa;-----------------------------------------------------------------------------------------&#xa;&#xa;&lt;b&gt;Q3&lt;/b&gt; | 7.15 Maintenance | If a vehicle is currently rented out or reserved, does opening a job card automatically flag a conflict or cancel upcoming reservations for that vehicle?&#xa;&#xa;-----------------------------------------------------------------------------------------&#xa;&#xa;&lt;b&gt;Q4&lt;/b&gt; | 7.8 Corporate Contracts | Can a corporate client have multiple active contracts simultaneously with overlapping validity periods but different discount rates, or only one active contract at a time?" mermaidId="n:Q_TABLE" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;#&lt;/b&gt; | &lt;b&gt;SRS Section&lt;/b&gt; | &lt;b&gt;Question&lt;/b&gt;&#xa;&#xa;-----------------------------------------------------------------------------------------&#xa;&#xa;&lt;b&gt;Q1&lt;/b&gt; | 7.1 Branches and Staff | What is the fallback if both the branch manager resigns and the regional director is temporarily unavailable to take over? Does the system need to log acting managers?&#xa;&#xa;-----------------------------------------------------------------------------------------&#xa;&#xa;&lt;b&gt;Q2&lt;/b&gt; | 7.16 Payments | For corporate clients who receive a single monthly invoice instead of paying per rental, does the system track credit billing cycles and corporate invoice IDs, or is corporate invoicing completely handled offline in Phase 1?&#xa;&#xa;-----------------------------------------------------------------------------------------&#xa;&#xa;&lt;b&gt;Q3&lt;/b&gt; | 7.15 Maintenance | If a vehicle is currently rented out or reserved, does opening a job card automatically flag a conflict or cancel upcoming reservations for that vehicle?&#xa;&#xa;-----------------------------------------------------------------------------------------&#xa;&#xa;&lt;b&gt;Q4&lt;/b&gt; | 7.8 Corporate Contracts | Can a corporate client have multiple active contracts simultaneously with overlapping validity periods but different discount rates, or only one active contract at a time?" id="6yz99jHD4Rz_dEeoc8f4-7">
          <mxCell parent="6yz99jHD4Rz_dEeoc8f4-6" style="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="1914" width="152" x="24" y="48" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Part C — Questions, Assumptions &amp;amp; Contradictions&lt;/b&gt;&lt;br&gt;Name: [Ammar Yasser | Group: [G1]" mermaidId="n:Title" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=3;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;Part C — Questions, Assumptions &amp; Contradictions&lt;/b&gt;&#xa;Name: [Your Name] | ID: [Your ID] | Group: [Your Group]" id="6yz99jHD4Rz_dEeoc8f4-8">
          <mxCell parent="6yz99jHD4Rz_dEeoc8f4-1" style="html=1;whiteSpace=wrap;strokeWidth=3;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="192" width="152" x="1130" y="1196" as="geometry" />
