        <UserObject label="" mermaidId="e:JOB_TABLE-&gt;JOB_NOTE#0" mermaidBaseStyle="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;startArrow=none;endArrow=none;jumpStyle=arc;jumpSize=12;strokeColor=#000000;exitX=0.44;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" mermaidBaseValue="" id="cdvPHzpmsmWbvyyc1B1x-236">
