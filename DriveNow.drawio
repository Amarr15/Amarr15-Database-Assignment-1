        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% ================= BRANCH =================\n    subgraph BRANCH_TABLE [BRANCH]\n        direction LR\n        B1[\&quot;&lt;u&gt;BranchCode&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        B2[\&quot;BranchName&lt;br&gt;NN UQ\&quot;]\n        B3[\&quot;Street&lt;br&gt;NN\&quot;]\n        B4[\&quot;City&lt;br&gt;NN\&quot;]\n        B5[\&quot;Governorate&lt;br&gt;NN\&quot;]\n        B6[\&quot;OpeningHours&lt;br&gt;NN\&quot;]\n        B7[\&quot;ClosingHours&lt;br&gt;NN\&quot;]\n        B8[\&quot;IsAirport24h&lt;br&gt;NN DF:0\&quot;]\n        B9[\&quot;ManagerID&lt;br&gt;NN UQ (FK)\&quot;]\n        B10[\&quot;ManagerStartDate&lt;br&gt;NN\&quot;]\n    end\n\n    %% ================= BRANCH_PHONE =================\n    subgraph BRANCH_PHONE_TABLE [BRANCH_PHONE]\n        direction LR\n        BP1[\&quot;&lt;u&gt;BranchCode&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        BP2[\&quot;&lt;u&gt;PhoneNumber&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n    end\n\n    %% ================= EMPLOYEE =================\n    subgraph EMPLOYEE_TABLE [EMPLOYEE]\n        direction LR\n        E1[\&quot;&lt;u&gt;EmployeeID&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        E2[\&quot;NationalID&lt;br&gt;NN UQ CK:LEN=14\&quot;]\n        E3[\&quot;FirstName&lt;br&gt;NN\&quot;]\n        E4[\&quot;MiddleName&lt;br&gt;NN\&quot;]\n        E5[\&quot;LastName&lt;br&gt;NN\&quot;]\n        E6[\&quot;DateOfBirth&lt;br&gt;NN\&quot;]\n        E7[\&quot;HireDate&lt;br&gt;NN\&quot;]\n        E8[\&quot;Salary&lt;br&gt;NN CK:&gt;0\&quot;]\n        E9[\&quot;Email&lt;br&gt;NN UQ\&quot;]\n        E10[\&quot;BranchCode&lt;br&gt;NN (FK)\&quot;]\n        E11[\&quot;SupervisorID&lt;br&gt;NULL (FK)\&quot;]\n        E12[\&quot;EmployeeType&lt;br&gt;NN CK:&#39;Agent&#39;|&#39;Mechanic&#39;|&#39;Other&#39;\&quot;]\n        E13[\&quot;CommissionRate&lt;br&gt;NULL CK:&lt;=0.15\&quot;]\n        E14[\&quot;Specialization&lt;br&gt;NULL CK:&#39;Engine&#39;|&#39;Electrical&#39;|&#39;Body&#39;|&#39;General&#39;\&quot;]\n        E15[\&quot;CertificationLevel&lt;br&gt;NULL CK:1-5\&quot;]\n    end\n\n    %% ================= TRAINING_COURSE =================\n    subgraph TRAINING_TABLE [TRAINING_COURSE]\n        direction LR\n        T1[\&quot;&lt;u&gt;CourseCode&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        T2[\&quot;Title&lt;br&gt;NN\&quot;]\n        T3[\&quot;Hours&lt;br&gt;NN CK:&gt;0\&quot;]\n        T4[\&quot;IsMandatory&lt;br&gt;NN DF:0\&quot;]\n    end\n\n    %% ================= EMPLOYEE_TRAINING =================\n    subgraph EMP_TRAIN_TABLE [EMPLOYEE_TRAINING]\n        direction LR\n        ET1[\&quot;&lt;u&gt;EmployeeID&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        ET2[\&quot;&lt;u&gt;CourseCode&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        ET3[\&quot;&lt;u&gt;AttemptNumber&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        ET4[\&quot;EnrollmentDate&lt;br&gt;NN\&quot;]\n        ET5[\&quot;CompletionDate&lt;br&gt;NULL\&quot;]\n        ET6[\&quot;Score&lt;br&gt;NULL CK:0-100\&quot;]\n        ET7[\&quot;Status&lt;br&gt;NN CK:&#39;Pass&#39;|&#39;Fail&#39;|&#39;Enrolled&#39;\&quot;]\n    end\n\n    %% ================= VEHICLE_CATEGORY =================\n    subgraph VCAT_TABLE [VEHICLE_CATEGORY]\n        direction LR\n        VC1[\&quot;&lt;u&gt;CategoryName&lt;/u&gt;&lt;br&gt;NN (PK) CK:&#39;Economy&#39;|&#39;Compact&#39;|&#39;SUV&#39;|&#39;Luxury&#39;|&#39;Van&#39;\&quot;]\n    end\n\n    %% ================= CATEGORY_PRICE_HISTORY =================\n    subgraph CPH_TABLE [CATEGORY_PRICE_HISTORY]\n        direction LR\n        CPH1[\&quot;&lt;u&gt;CategoryName&lt;/u&gt;&lt;br&gt;NN (PK, FK)\&quot;]\n        CPH2[\&quot;&lt;u&gt;StartDate&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        CPH3[\&quot;EndDate&lt;br&gt;NULL\&quot;]\n        CPH4[\&quot;DailyRate&lt;br&gt;NN CK:&gt;0\&quot;]\n    end\n\n    %% ================= CAR_MODEL =================\n    subgraph CAR_MODEL_TABLE [CAR_MODEL]\n        direction LR\n        CM1[\&quot;&lt;u&gt;ModelID&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        CM2[\&quot;Manufacturer&lt;br&gt;NN\&quot;]\n        CM3[\&quot;ModelName&lt;br&gt;NN\&quot;]\n        CM4[\&quot;Year&lt;br&gt;NN\&quot;]\n        CM5[\&quot;NumSeats&lt;br&gt;NN CK:&gt;0\&quot;]\n        CM6[\&quot;TransmissionType&lt;br&gt;NN CK:&#39;Manual&#39;|&#39;Automatic&#39;\&quot;]\n        CM7[\&quot;FuelType&lt;br&gt;NN CK:&#39;Petrol&#39;|&#39;Diesel&#39;|&#39;Hybrid&#39;|&#39;Electric&#39;\&quot;]\n        CM8[\&quot;CategoryName&lt;br&gt;NN (FK)\&quot;]\n    end\n\n    %% ================= VEHICLE =================\n    subgraph VEHICLE_TABLE [VEHICLE]\n        direction LR\n        V1[\&quot;&lt;u&gt;VIN&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        V2[\&quot;PlateNumber&lt;br&gt;NN UQ\&quot;]\n        V3[\&quot;Color&lt;br&gt;NN\&quot;]\n        V4[\&quot;CurrentOdometer&lt;br&gt;NN CK:&gt;=0\&quot;]\n        V5[\&quot;PurchaseDate&lt;br&gt;NN\&quot;]\n        V6[\&quot;PurchasePrice&lt;br&gt;NN CK:&gt;0\&quot;]\n        V7[\&quot;Status&lt;br&gt;NN CK:&#39;Available&#39;|&#39;Rented&#39;|&#39;Under Maintenance&#39;|&#39;Retired&#39;\&quot;]\n        V8[\&quot;CustomDailyPrice&lt;br&gt;NULL CK:&gt;0\&quot;]\n        V9[\&quot;ModelID&lt;br&gt;NN (FK)\&quot;]\n        V10[\&quot;HomeBranchCode&lt;br&gt;NN (FK)\&quot;]\n        V11[\&quot;CurrentBranchCode&lt;br&gt;NN (FK)\&quot;]\n    end\n\n    %% ================= GPS_DEVICE =================\n    subgraph GPS_TABLE [GPS_DEVICE]\n        direction LR\n        G1[\&quot;&lt;u&gt;SerialNumber&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        G2[\&quot;Manufacturer&lt;br&gt;NN\&quot;]\n        G3[\&quot;SIMCardNumber&lt;br&gt;NN UQ\&quot;]\n        G4[\&quot;InstalledVIN&lt;br&gt;NULL UQ (FK)\&quot;]\n        G5[\&quot;InstallationDate&lt;br&gt;NULL\&quot;]\n    end\n\n    %% ================= EXTRA_EQUIPMENT =================\n    subgraph EXTRA_TABLE [EXTRA_EQUIPMENT]\n        direction LR\n        X1[\&quot;&lt;u&gt;ExtraCode&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        X2[\&quot;ExtraName&lt;br&gt;NN\&quot;]\n        X3[\&quot;CurrentDailyCharge&lt;br&gt;NN CK:&gt;=0\&quot;]\n    end\n\n    %% ================= VEHICLE_TRANSFER =================\n    subgraph TRANSFER_TABLE [VEHICLE_TRANSFER]\n        direction LR\n        TR1[\&quot;&lt;u&gt;TransferID&lt;/u&gt;&lt;br&gt;NN (PK)\&quot;]\n        TR2[\&quot;VIN&lt;br&gt;NN (FK)\&quot;]\n        TR3[\&quot;FromBranchCode&lt;br&gt;NN (FK)\&quot;]\n        TR4[\&quot;ToBranchCode&lt;br&gt;NN (FK)\&quot;]\n        TR5[\&quot;DriverEmployeeID&lt;br&gt;NN (FK)\&quot;]\n        TR6[\&quot;TransferDateTime&lt;br&gt;NN\&quot;]\n        TR7[\&quot;OdometerAtTransfer&lt;br&gt;NN CK:&gt;=0\&quot;]\n    end\n\n    %% ================= Relationships (FK Arrows) =================\n    B9 --&gt;|FK| E1\n    BP1 --&gt;|FK| B1\n    E10 --&gt;|FK| B1\n    E11 --&gt;|FK| E1\n    ET1 --&gt;|FK| E1\n    ET2 --&gt;|FK| T1\n    CPH1 --&gt;|FK| VC1\n    CM8 --&gt;|FK| VC1\n    V9 --&gt;|FK| CM1\n    V10 --&gt;|FK| B1\n    V11 --&gt;|FK| B1\n    G4 --&gt;|FK| V1\n    TR2 --&gt;|FK| V1\n    TR3 --&gt;|FK| B1\n    TR4 --&gt;|FK| B1\n    TR5 --&gt;|FK| E1\n\n    %% ================= Table Constraints (Notes) =================\n    CPH_TABLE_NOTE[\&quot;CK: EndDate &gt;= StartDate\&quot;]\n    CPH_TABLE --- CPH_TABLE_NOTE\n    \n    TRANSFER_TABLE_NOTE[\&quot;CK: FromBranchCode != ToBranchCode\&quot;]\n    TRANSFER_TABLE --- TRANSFER_TABLE_NOTE\n\n    %% ================= Styles =================\n    classDef tableHeader fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px,font-weight:bold\n    classDef colBox fill:#ffffff,stroke:#64748b,color:#111827,stroke-width:1.5px\n    classDef noteBox fill:#fef3c7,stroke:#b45309,color:#111827,stroke-width:1.5px,stroke-dasharray: 3 3\n\n    class B1,B2,B3,B4,B5,B6,B7,B8,B9,B10,BP1,BP2,E1,E2,E3,E4,E5,E6,E7,E8,E9,E10,E11,E12,E13,E14,E15,T1,T2,T3,T4,ET1,ET2,ET3,ET4,ET5,ET6,ET7,VC1,CPH1,CPH2,CPH3,CPH4,CM1,CM2,CM3,CM4,CM5,CM6,CM7,CM8,V1,V2,V3,V4,V5,V6,V7,V8,V9,V10,V11,G1,G2,G3,G4,G5,X1,X2,X3,TR1,TR2,TR3,TR4,TR5,TR6,TR7 colBox\n    class CPH_TABLE_NOTE,TRANSFER_TABLE_NOTE noteBox&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="F2nErifSjSIO_tY8eqyN-1">
