        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% ================= Entities =================\n    JOB[JOB_CARD]\n    PART[PART]\n    SUP[SUPPLIER]\n    DMG[[DAMAGE_REPORT]]\n    VIOL[TRAFFIC_VIOLATION]\n    FB[FEEDBACK]\n\n    %% External Entities (Dashed)\n    VEH[/VEHICLE/]\n    EMP[/EMPLOYEE/]\n    RENT[/RENTAL/]\n\n    %% ================= JOB_CARD Attributes =================\n    JNO([\&quot;&lt;u&gt;JobNo (PK)&lt;/u&gt;\&quot;])\n    JDIN([\&quot;DateIn\&quot;])\n    JDOUT([\&quot;DateOut\&quot;])\n    JWT([\&quot;WorkType\&quot;])\n    JTCOST([\&quot;TotalCost\&quot;])\n    JOB --- JNO\n    JOB --- JDIN\n    JOB --- JDOUT\n    JOB --- JWT\n    JOB --- JTCOST\n\n    %% ================= PART Attributes =================\n    PNO([\&quot;&lt;u&gt;PartNo (PK)&lt;/u&gt;\&quot;])\n    PNAME([\&quot;PartName\&quot;])\n    PCOST([\&quot;CurrentUnitCost\&quot;])\n    PQTY([\&quot;QuantityInStock\&quot;])\n    PART --- PNO\n    PART --- PNAME\n    PART --- PCOST\n    PART --- PQTY\n\n    %% ================= SUPPLIER Attributes =================\n    SID([\&quot;&lt;u&gt;SupplierID (PK)&lt;/u&gt;\&quot;])\n    SNAME([\&quot;SupplierName\&quot;])\n    SPH([\&quot;Phone\&quot;])\n    SEMAIL([\&quot;Email\&quot;])\n    SUP --- SID\n    SUP --- SNAME\n    SUP --- SPH\n    SUP --- SEMAIL\n\n    %% ================= DAMAGE_REPORT Attributes (Weak) =================\n    RID([\&quot;&lt;u&gt;ReportID (PK / Partial Key)&lt;/u&gt;\&quot;])\n    RDESC([\&quot;Description\&quot;])\n    RSEV([\&quot;Severity\&quot;])\n    REST([\&quot;EstimatedRepairCost\&quot;])\n    RPHOTOS([\&quot;Photos (Multivalued)\&quot;])\n    DMG --- RID\n    DMG --- RDESC\n    DMG --- RSEV\n    DMG --- REST\n    DMG --- RPHOTOS\n\n    %% ================= TRAFFIC_VIOLATION Attributes =================\n    VNO([\&quot;&lt;u&gt;ViolationNo (PK)&lt;/u&gt;\&quot;])\n    VDT([\&quot;ViolationDateTime\&quot;])\n    VLOC([\&quot;Location\&quot;])\n    VTYPE([\&quot;ViolationType\&quot;])\n    VFINE([\&quot;FineAmount\&quot;])\n    VIOL --- VNO\n    VIOL --- VDT\n    VIOL --- VLOC\n    VIOL --- VTYPE\n    VIOL --- VFINE\n\n    %% ================= FEEDBACK Attributes =================\n    FBID([\&quot;&lt;u&gt;FeedbackID (PK)&lt;/u&gt;\&quot;])\n    FRATE([\&quot;Rating (1-5)\&quot;])\n    FCOM([\&quot;Comment\&quot;])\n    FSUB([\&quot;SubmissionDate\&quot;])\n    FB --- FBID\n    FB --- FRATE\n    FB --- FCOM\n    FB --- FSUB\n\n    %% ================= Relationships =================\n    MAINTAINS{\&quot;MAINTAINS_VEHICLE\&quot;}\n    ASSIGNED{\&quot;ASSIGNED_MECHANIC\&quot;}\n    RESULTS{\&quot;RESULTS_FROM_DAMAGE\&quot;}\n    USES{\&quot;USES_PART\&quot;}\n    SUPPLIES{\&quot;SUPPLIES_PART\&quot;}\n    INSPECT{\&quot;INSPECTED_ON_RETURN\&quot;}\n    REP_BY{\&quot;REPORTED_BY\&quot;}\n    INCUR{\&quot;INCURRED_DURING\&quot;}\n    GIVEN{\&quot;GIVEN_FOR_RENTAL\&quot;}\n\n    %% MAINTAINS_VEHICLE (N:1)\n    JOB ---|\&quot;N\&quot;| MAINTAINS\n    MAINTAINS ---|\&quot;1\&quot;| VEH\n\n    %% ASSIGNED_MECHANIC (M:N)\n    JOB ---|\&quot;M\&quot;| ASSIGNED\n    ASSIGNED ---|\&quot;N\&quot;| EMP\n    ASSIGNED --- ASGN_HRS([\&quot;HoursSpent\&quot;])\n\n    %% RESULTS_FROM_DAMAGE (1:1 Optional)\n    JOB ---|\&quot;1 (Optional)\&quot;| RESULTS\n    RESULTS ---|\&quot;1\&quot;| DMG\n\n    %% USES_PART (M:N)\n    JOB ---|\&quot;M\&quot;| USES\n    USES ---|\&quot;N\&quot;| PART\n    USES --- USE_QTY([\&quot;QuantityUsed\&quot;])\n    USES --- USE_COST([\&quot;UnitCostAtTime\&quot;])\n\n    %% SUPPLIES_PART (M:N)\n    PART ---|\&quot;M\&quot;| SUPPLIES\n    SUPPLIES ---|\&quot;N\&quot;| SUP\n    SUPPLIES --- SUP_PRICE([\&quot;SupplierPrice\&quot;])\n    SUPPLIES --- SUP_LEAD([\&quot;LeadTimeDays\&quot;])\n\n    %% INSPECTED_ON_RETURN (1:N)\n    DMG ---|\&quot;N\&quot;| INSPECT\n    INSPECT ---|\&quot;1\&quot;| RENT\n\n    %% REPORTED_BY (N:1)\n    DMG ---|\&quot;N\&quot;| REP_BY\n    REP_BY ---|\&quot;1\&quot;| EMP\n\n    %% INCURRED_DURING (N:1)\n    VIOL ---|\&quot;N\&quot;| INCUR\n    INCUR ---|\&quot;1\&quot;| RENT\n\n    %% GIVEN_FOR_RENTAL (1:1 Optional)\n    FB ---|\&quot;1 (Optional)\&quot;| GIVEN\n    GIVEN ---|\&quot;1\&quot;| RENT\n\n    %% ================= Styles =================\n    classDef entity fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px\n    classDef weakEntity fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:3px,stroke-dasharray: 4 2\n    classDef attribute fill:#ffffff,stroke:#64748b,color:#111827\n    classDef relationship fill:#fef3c7,stroke:#b45309,color:#111827\n    classDef external fill:#f3f4f6,stroke:#6b7280,color:#111827,stroke-width:2px,stroke-dasharray: 5 5\n\n    class JOB,PART,SUP,VIOL,FB entity\n    class DMG weakEntity\n    class JNO,JDIN,JDOUT,JWT,JTCOST,PNO,PNAME,PCOST,PQTY,SID,SNAME,SPH,SEMAIL,RID,RDESC,RSEV,REST,RPHOTOS,VNO,VDT,VLOC,VTYPE,VFINE,FBID,FRATE,FCOM,FSUB,ASGN_HRS,USE_QTY,USE_COST,SUP_PRICE,SUP_LEAD attribute\n    class MAINTAINS,ASSIGNED,RESULTS,USES,SUPPLIES,INSPECT,REP_BY,INCUR,GIVEN relationship\n    class VEH,EMP,RENT external&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="S0y-A3yQEiPwy4HA630Q-1">
