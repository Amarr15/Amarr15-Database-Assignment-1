        <UserObject label="&lt;b&gt;SRS Section:&lt;/b&gt; 7.6 &amp; 8 (Fleet Manager)" mermaidId="n:R1_SRS" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontStyle=1;" mermaidBaseValue="&lt;b&gt;SRS Section:&lt;/b&gt; 7.6 &amp; 8 (Fleet Manager)" id="FflQV6nAqRwETxv3Kj53-35">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-34" style="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontStyle=1;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="87" width="152" x="24" y="48" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Business Rule:&lt;/b&gt;&#xa;No vehicle can be transferred to the same branch it is currently located at, and the origin branch must match the vehicle&#39;s current actual branch." mermaidId="n:R1_RULE" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;Business Rule:&lt;/b&gt;&#xa;No vehicle can be transferred to the same branch it is currently located at, and the origin branch must match the vehicle&#39;s current actual branch." id="FflQV6nAqRwETxv3Kj53-36">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-34" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="277" width="152" x="24" y="159" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&#xa;Standard CHECK constraints can only compare columns within the same row (FromBranch != ToBranch). They cannot query the VEHICLE table to verify whether FromBranch matches the vehicle&#39;s real-time current branch location (VEHICLE.CurrentBranchCode)." mermaidId="n:R1_WHY" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;Why constraints are not enough:&lt;/b&gt;&#xa;Standard CHECK constraints can only compare columns within the same row (FromBranch != ToBranch). They cannot query the VEHICLE table to verify whether FromBranch matches the vehicle&#39;s real-time current branch location (VEHICLE.CurrentBranchCode)." id="FflQV6nAqRwETxv3Kj53-37">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-34" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="423" width="152" x="24" y="459" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;How to enforce it:&lt;/b&gt;&#xa;Enforced via a BEFORE INSERT Trigger on the VEHICLE_TRANSFER table (or a stored procedure) that validates FromBranchCode == VEHICLE.CurrentBranchCode, rejects the transfer if invalid, and upon approval updates VEHICLE.CurrentBranchCode = ToBranchCode." mermaidId="n:R1_HOW" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;How to enforce it:&lt;/b&gt;&#xa;Enforced via a BEFORE INSERT Trigger on the VEHICLE_TRANSFER table (or a stored procedure) that validates FromBranchCode == VEHICLE.CurrentBranchCode, rejects the transfer if invalid, and upon approval updates VEHICLE.CurrentBranchCode = ToBranchCode." id="FflQV6nAqRwETxv3Kj53-38">
          <mxCell parent="FflQV6nAqRwETxv3Kj53-34" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#64748b;fontColor=#111827;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="444" width="152" x="24" y="906" as="geometry" />
          </mxCell>
        </UserObject>
