        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% ================= Entities =================\n    CUST[CUSTOMER]\n    IND[INDIVIDUAL_CUSTOMER]\n    CORP[CORPORATE_CUSTOMER]\n    ADRIVER[[AUTHORIZED_DRIVER]]\n    BLACK[BLACKLIST_RECORD]\n    PROMO[PROMO_CODE]\n    RES[RESERVATION]\n    RENT[RENTAL]\n    INS[INSURANCE_PACKAGE]\n    PAY[PAYMENT]\n    LOY[LOYALTY_TRANSACTION]\n\n    %% External Entities (Dashed)\n    VEH[/VEHICLE/]\n    VCAT[/VEHICLE_CATEGORY/]\n    BRANCH[/BRANCH/]\n    EMP[/EMPLOYEE/]\n    EXTRA[/EXTRA_EQUIPMENT/]\n\n    %% ================= CUSTOMER Attributes =================\n    CID([\&quot;&lt;u&gt;CustomerID (PK)&lt;/u&gt;\&quot;])\n    CEMAIL([\&quot;Email\&quot;])\n    CADDR([\&quot;Address\&quot;])\n    CREG([\&quot;RegistrationDate\&quot;])\n    CPHONE([\&quot;PhoneNumbers (Multivalued)\&quot;])\n    CTYPE([\&quot;CustomerType (d: Individual/Corporate)\&quot;])\n    CUST --- CID\n    CUST --- CEMAIL\n    CUST --- CADDR\n    CUST --- CREG\n    CUST --- CPHONE\n    CUST --- CTYPE\n\n    %% ================= INDIVIDUAL_CUSTOMER Attributes =================\n    IFNAME([\&quot;FirstName\&quot;])\n    ILNAME([\&quot;LastName\&quot;])\n    IDOB([\&quot;DateOfBirth\&quot;])\n    IIDTYPE([\&quot;IDType\&quot;])\n    IIDNUM([\&quot;IDNumber\&quot;])\n    ILIC([\&quot;LicenseNumber\&quot;])\n    ILICC([\&quot;LicenseCountry\&quot;])\n    ILICE([\&quot;LicenseExpiryDate\&quot;])\n    ILOYAL([\&quot;LoyaltyPoints (Derived)\&quot;])\n    ITIER([\&quot;LoyaltyTier\&quot;])\n    IND --- IFNAME\n    IND --- ILNAME\n    IND --- IDOB\n    IND --- IIDTYPE\n    IND --- IIDNUM\n    IND --- ILIC\n    IND --- ILICC\n    IND --- ILICE\n    IND --- ILOYAL\n    IND --- ITIER\n\n    %% ================= CORPORATE_CUSTOMER Attributes =================\n    CCOMP([\&quot;CompanyName\&quot;])\n    CTAX([\&quot;TaxRegistrationNumber\&quot;])\n    CCONT([\&quot;ContactPersonName\&quot;])\n    CCRED([\&quot;CreditLimit\&quot;])\n    CORP --- CCOMP\n    CORP --- CTAX\n    CORP --- CCONT\n    CORP --- CCRED\n\n    %% ================= AUTHORIZED_DRIVER Attributes (Weak) =================\n    ADNO([\&quot;&lt;u&gt;CompanyDriverNo (Partial Key)&lt;/u&gt;\&quot;])\n    ADFN([\&quot;FullName\&quot;])\n    ADLIC([\&quot;LicenseNumber\&quot;])\n    ADEXP([\&quot;LicenseExpiryDate\&quot;])\n    ADPH([\&quot;Phone\&quot;])\n    ADRIVER --- ADNO\n    ADRIVER --- ADFN\n    ADRIVER --- ADLIC\n    ADRIVER --- ADEXP\n    ADRIVER --- ADPH\n\n    %% ================= BLACKLIST_RECORD Attributes =================\n    BID([\&quot;&lt;u&gt;BlacklistID (PK)&lt;/u&gt;\&quot;])\n    BREASON([\&quot;Reason\&quot;])\n    BDATE([\&quot;BlacklistDate\&quot;])\n    BLACK --- BID\n    BLACK --- BREASON\n    BLACK --- BDATE\n\n    %% ================= PROMO_CODE Attributes =================\n    PCODE([\&quot;&lt;u&gt;PromoCode (PK)&lt;/u&gt;\&quot;])\n    PDISC([\&quot;DiscountPercentage\&quot;])\n    PSTART([\&quot;StartDate\&quot;])\n    PEND([\&quot;EndDate\&quot;])\n    PMAX([\&quot;MaxUses\&quot;])\n    PTIMES([\&quot;TimesUsed\&quot;])\n    PROMO --- PCODE\n    PROMO --- PDISC\n    PROMO --- PSTART\n    PROMO --- PEND\n    PROMO --- PMAX\n    PROMO --- PTIMES\n\n    %% ================= RESERVATION Attributes =================\n    RNO([\&quot;&lt;u&gt;ReservationNo (PK)&lt;/u&gt;\&quot;])\n    RBOOK([\&quot;BookingDateTime\&quot;])\n    RPICK([\&quot;PickupDateTime\&quot;])\n    REXP([\&quot;ExpectedReturnDateTime\&quot;])\n    RSTAT([\&quot;Status\&quot;])\n    RES --- RNO\n    RES --- RBOOK\n    RES --- RPICK\n    RES --- REXP\n    RES --- RSTAT\n\n    %% ================= RENTAL Attributes =================\n    RENTNO([\&quot;&lt;u&gt;RentalNo (PK)&lt;/u&gt;\&quot;])\n    RPICKDT([\&quot;PickupDateTime\&quot;])\n    REXPDT([\&quot;ExpectedReturnDateTime\&quot;])\n    RACTDT([\&quot;ActualReturnDateTime\&quot;])\n    RPICKODO([\&quot;PickupOdometer\&quot;])\n    RRETODO([\&quot;ReturnOdometer\&quot;])\n    RPICKFUEL([\&quot;PickupFuelPercentage\&quot;])\n    RRETFUEL([\&quot;ReturnFuelPercentage\&quot;])\n    RLATEFEE([\&quot;LateFeeCharged\&quot;])\n    RENT --- RENTNO\n    RENT --- RPICKDT\n    RENT --- REXPDT\n    RENT --- RACTDT\n    RENT --- RPICKODO\n    RENT --- RRETODO\n    RENT --- RPICKFUEL\n    RENT --- RRETFUEL\n    RENT --- RLATEFEE\n\n    %% ================= INSURANCE_PACKAGE Attributes =================\n    IPCODE([\&quot;&lt;u&gt;PackageCode (PK)&lt;/u&gt;\&quot;])\n    IPNAME([\&quot;PackageName\&quot;])\n    IPDAILY([\&quot;DailyPrice\&quot;])\n    IPMAX([\&quot;MaxCoverage\&quot;])\n    IPDED([\&quot;Deductible\&quot;])\n    INS --- IPCODE\n    INS --- IPNAME\n    INS --- IPDAILY\n    INS --- IPMAX\n    INS --- IPDED\n\n    %% ================= PAYMENT Attributes =================\n    PAYID([\&quot;&lt;u&gt;PaymentID (PK)&lt;/u&gt;\&quot;])\n    PAMT([\&quot;Amount\&quot;])\n    PDT([\&quot;PaymentDateTime\&quot;])\n    PTYPE([\&quot;PaymentType\&quot;])\n    PMETHOD([\&quot;Method\&quot;])\n    PREF([\&quot;BankTransactionRef (Unique, Nullable)\&quot;])\n    PAY --- PAYID\n    PAY --- PAMT\n    PAY --- PDT\n    PAY --- PTYPE\n    PAY --- PMETHOD\n    PAY --- PREF\n\n    %% ================= LOYALTY_TRANSACTION Attributes =================\n    LTID([\&quot;&lt;u&gt;TransactionID (PK)&lt;/u&gt;\&quot;])\n    LTDATE([\&quot;TransactionDate\&quot;])\n    LTPTS([\&quot;Points\&quot;])\n    LTTYPE([\&quot;TransactionType\&quot;])\n    LOY --- LTID\n    LOY --- LTDATE\n    LOY --- LTPTS\n    LOY --- LTTYPE\n\n    %% ================= Generalization =================\n    ISA_CUST{{\&quot;ISA - Disjoint (d)\&quot;}}\n    CUST --- ISA_CUST\n    ISA_CUST --- IND\n    ISA_CUST --- CORP\n\n    %% ================= Relationships =================\n    IDENT{\&quot;IDENTIFIES\&quot;}\n    PLACES{\&quot;PLACES_RES\&quot;}\n    RES_CAT{\&quot;RESERVES_CAT\&quot;}\n    APPLIES{\&quot;APPLIES_PROMO\&quot;}\n    R_PICK{\&quot;RES_PICKUP_BRANCH\&quot;}\n    R_RET{\&quot;RES_RETURN_BRANCH\&quot;}\n    TURNS{\&quot;TURNS_INTO\&quot;}\n    SIGNS{\&quot;SIGNS_RENTAL\&quot;}\n    RENTS{\&quot;RENTS_VEHICLE\&quot;}\n    RNT_PICK{\&quot;RENTAL_PICKUP_BRANCH\&quot;}\n    RNT_RET{\&quot;RENTAL_RETURN_BRANCH\&quot;}\n    HANDED{\&quot;HANDED_OVER_BY\&quot;}\n    RECEIVED{\&quot;RECEIVED_BY\&quot;}\n    MAINDRV{\&quot;MAIN_DRIVER\&quot;}\n    EXTENDS{\&quot;EXTENDS\&quot;}\n    R_EXTRAS{\&quot;RENTAL_EXTRAS\&quot;}\n    R_INS{\&quot;RENTAL_INSURANCE\&quot;}\n    HASPAY{\&quot;HAS_PAYMENT\&quot;}\n    BL_BY{\&quot;BLACKLISTED_BY\&quot;}\n    EARNS{\&quot;EARNS_POINTS\&quot;}\n\n    %% IDENTIFIES (1:N) - Double Diamond\n    CORP ===|\&quot;1\&quot;| IDENT\n    IDENT ===|\&quot;N\&quot;| ADRIVER\n\n    %% PLACES_RES (1:N)\n    CUST ---|\&quot;1\&quot;| PLACES\n    PLACES ---|\&quot;N\&quot;| RES\n\n    %% RESERVES_CAT (N:1)\n    RES ---|\&quot;N\&quot;| RES_CAT\n    RES_CAT ---|\&quot;1\&quot;| VCAT\n\n    %% APPLIES_PROMO (N:1 Optional)\n    RES ---|\&quot;N (Optional)\&quot;| APPLIES\n    APPLIES ---|\&quot;1\&quot;| PROMO\n\n    %% Reservation Branches (N:1)\n    RES ---|\&quot;N\&quot;| R_PICK\n    R_PICK ---|\&quot;1\&quot;| BRANCH\n    RES ---|\&quot;N\&quot;| R_RET\n    R_RET ---|\&quot;1\&quot;| BRANCH\n\n    %% TURNS_INTO (1:1 Optional)\n    RES ---|\&quot;1 (Optional)\&quot;| TURNS\n    TURNS ---|\&quot;1\&quot;| RENT\n\n    %% SIGNS_RENTAL (1:N)\n    CUST ---|\&quot;1\&quot;| SIGNS\n    SIGNS ---|\&quot;N\&quot;| RENT\n\n    %% RENTS_VEHICLE (N:1)\n    RENT ---|\&quot;N\&quot;| RENTS\n    RENTS ---|\&quot;1\&quot;| VEH\n\n    %% Rental Branches (N:1)\n    RENT ---|\&quot;N\&quot;| RNT_PICK\n    RNT_PICK ---|\&quot;1\&quot;| BRANCH\n    RENT ---|\&quot;N\&quot;| RNT_RET\n    RNT_RET ---|\&quot;1\&quot;| BRANCH\n\n    %% HANDED_OVER_BY (N:1 Mandatory)\n    RENT ===|\&quot;N\&quot;| HANDED\n    HANDED ---|\&quot;1\&quot;| EMP\n\n    %% RECEIVED_BY (N:1 Optional)\n    RENT ---|\&quot;N (Optional)\&quot;| RECEIVED\n    RECEIVED ---|\&quot;1\&quot;| EMP\n\n    %% MAIN_DRIVER (N:1 Optional)\n    RENT ---|\&quot;N (Optional)\&quot;| MAINDRV\n    MAINDRV ---|\&quot;1\&quot;| ADRIVER\n\n    %% EXTENDS (1:1 Recursive)\n    RENT ---|\&quot;OriginalRental (1)\&quot;| EXTENDS\n    EXTENDS ---|\&quot;ExtendedRental (1)\&quot;| RENT\n\n    %% RENTAL_EXTRAS (M:N)\n    RENT ---|\&quot;M\&quot;| R_EXTRAS\n    R_EXTRAS ---|\&quot;N\&quot;| EXTRA\n    R_EXTRAS --- REX_QTY([\&quot;Quantity\&quot;])\n    R_EXTRAS --- REX_CHG([\&quot;ChargeAtRental\&quot;])\n\n    %% RENTAL_INSURANCE (M:N)\n    RENT ---|\&quot;M\&quot;| R_INS\n    R_INS ---|\&quot;N\&quot;| INS\n    R_INS --- RINS_PRICE([\&quot;PriceAtRental\&quot;])\n\n    %% HAS_PAYMENT (1:N)\n    RENT ---|\&quot;1\&quot;| HASPAY\n    HASPAY ---|\&quot;N\&quot;| PAY\n\n    %% BLACKLISTED_BY\n    CUST ---|\&quot;1\&quot;| BL_BY\n    BL_BY ---|\&quot;N\&quot;| BLACK\n    BLACK ---|\&quot;N\&quot;| BL_BY\n    BL_BY ---|\&quot;1\&quot;| EMP\n\n    %% EARNS_POINTS (1:N Optional)\n    RENT ---|\&quot;1 (Optional)\&quot;| EARNS\n    EARNS ---|\&quot;N\&quot;| LOY\n\n    %% ================= Styles =================\n    classDef entity fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px\n    classDef weakEntity fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:3px,stroke-dasharray: 4 2\n    classDef attribute fill:#ffffff,stroke:#64748b,color:#111827\n    classDef relationship fill:#fef3c7,stroke:#b45309,color:#111827\n    classDef strongRel fill:#fef3c7,stroke:#b45309,color:#111827,stroke-width:2px\n    classDef external fill:#f3f4f6,stroke:#6b7280,color:#111827,stroke-width:2px,stroke-dasharray: 5 5\n\n    class CUST,IND,CORP,BLACK,PROMO,RES,RENT,INS,PAY,LOY entity\n    class ADRIVER weakEntity\n    class CID,CEMAIL,CADDR,CREG,CPHONE,CTYPE,IFNAME,ILNAME,IDOB,IIDTYPE,IIDNUM,ILIC,ILICC,ILICE,ILOYAL,ITIER,CCOMP,CTAX,CCONT,CCRED,ADNO,ADFN,ADLIC,ADEXP,ADPH,BID,BREASON,BDATE,PCODE,PDISC,PSTART,PEND,PMAX,PTIMES,RNO,RBOOK,RPICK,REXP,RSTAT,RENTNO,RPICKDT,REXPDT,RACTDT,RPICKODO,RRETODO,RPICKFUEL,RRETFUEL,RLATEFEE,IPCODE,IPNAME,IPDAILY,IPMAX,IPDED,PAYID,PAMT,PDT,PTYPE,PMETHOD,PREF,LTID,LTDATE,LTPTS,LTTYPE,REX_QTY,REX_CHG,RINS_PRICE attribute\n    class IDENT,PLACES,RES_CAT,APPLIES,R_PICK,R_RET,TURNS,SIGNS,RENTS,RNT_PICK,RNT_RET,HANDED,RECEIVED,MAINDRV,EXTENDS,R_EXTRAS,R_INS,HASPAY,BL_BY,EARNS relationship\n    class IDENT,HANDED strongRel\n    class VEH,VCAT,BRANCH,EMP,EXTRA external&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="cRj0KChq-93i_OcUd3Zx-1">
